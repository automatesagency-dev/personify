# Copy this file to `.env` and fill in the values (never commit the real .env).

# ── Server ──
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000
# Canonical app URL used in email links. Local: http://localhost:3000  Prod: https://personify.so
APP_URL=http://localhost:3000

# ── Database (Railway Postgres public connection string) ──
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway?sslmode=require

# ── Auth ──
JWT_SECRET=

# ── Admins (comma-separated) ──
ADMIN_EMAILS=admin@automatesagency.com,joanne@automatesagency.com

# ── AI providers ──
OPENAI_API_KEY=
FAL_KEY=

# ── Google OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Resend) ──
RESEND_API_KEY=
EMAIL_FROM=Personify <noreply@send.personify.so>

# ── File storage (Cloudflare R2) ──
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
UPLOAD_DIR=./uploads

# ── Stripe (use TEST keys locally, LIVE keys only in production) ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=

# ── Cost estimates for admin margin (optional) ──
COST_IMAGE_CENTS=8
COST_TEXT_CENTS=1
