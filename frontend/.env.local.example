# Copy this file to `.env.local` and fill in the values (never commit the real one).

# Google OAuth client id (public — safe to expose)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Backend API base URL. Leave UNSET locally to use the http://localhost:5000/api
# fallback. In production this points at your deployed backend, e.g.
# NEXT_PUBLIC_API_URL=https://<your-backend>.up.railway.app/api
